{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wedding-moment",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat", "nodejs_compat_populate_process_env"],
  "main": "@tanstack/react-start/server-entry",
  // Declares intent to run the retention-purge job daily at 02:00 UTC. No
  // native Cloudflare Worker `scheduled` handler is wired up yet to act on
  // this trigger — see Task 19's report for why (the installed
  // @tanstack/react-start's `createServerEntry` helper strips any export
  // key besides `fetch`, and swapping `main` to a hand-rolled entry point
  // to add a `scheduled` export was ruled out of scope as too risky for
  // this task). Until that follow-up lands, POST /api/cron/purge must be
  // invoked by an external scheduler (e.g. a GitHub Actions cron workflow)
  // with the `x-cron-secret` header set to the deployed CRON_SECRET.
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "vars": {
    "BETTER_AUTH_URL": "https://wedding-moment.cahrizki-rf.workers.dev"
  },
  // Without this, `wrangler deploy` deletes any environment variable that
  // was set via the Cloudflare dashboard (not `wrangler secret put`) before
  // applying this file's config — since this file declares no `vars` block,
  // that wipes them on every deploy. Secrets set via `wrangler secret put`
  // are unaffected either way (Cloudflare never deletes those on deploy).
  "keep_vars": true
}
